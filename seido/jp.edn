;; 制度パック: 日本（国の法令レベル）
;; 出典は e-Gov 法令 API v2 で 2026-11-18, 2026-11-23, 2026-11-26 に取得し、応答 JSON の sha256 を記録した
;; （AWAI-3780 で戸籍法 第49条・第86条と住民基本台帳法 第30条の46を追加、
;;   AWAI-4076/AWAI-4075 で所得税法、消費税法、国税通則法、税理士法、電子帳簿保存法、および国税庁公式案内を追加）。
;; 専門家レビューは未実施。:review/status :unreviewed の間は「候補」の提示だけを許し、
;; 提出の提案はしない（AWAI-155）。
{:pack/id :jp/residence-and-corporate-address
 :pack/version "2026.11.26-1"
 :pack/jurisdiction [:jp]
 :pack/language :ja
 ;; 国の法令だけで候補を出せるが、窓口・様式は市町村ごとに違うので、
 ;; 受付先の市町村が確認できないときは結論を出さない。
 :pack/requires-subdivision false
 :pack/subdivisions
 {:jp.fixture/city-a {:name "架空市A（テスト用・実在しない）" :fixture true}
  :jp.fixture/city-b {:name "架空市B（テスト用・実在しない）" :fixture true}}
 :pack/checked-on "2026-11-23"
 :pack/review-by "2027-02-18"
 :review/status :unreviewed
 :review/reviewer nil
 :review/reviewed-on nil

 ;; AWAI-4075: 資格制度・独占業務の範囲
 :pack/regulated-professions
 {:jp.profession/zeirishi
  {:statute :jp.law/zeirishi-52
   :title "税理士業務の制限（税理士法 第52条）"
   :monopoly-scope #{:tax-representation :tax-document-preparation :tax-consultation}
   :policy "税務代理・税務書類作成・個別税務相談は行わない。本人が自ら行う申告手続の候補・期限・提出先の案内に限る。"}}

 ;; AWAI-4075: 電子帳簿保存法の保存要件の概要
 :pack/electronic-preservation-requirements
 {:statute-books-and-scanners :jp.law/denshichobo-4
  :statute-electronic-transactions :jp.law/denshichobo-7
  :overview "電子計算機を使用して作成する国税関係帳簿書類の保存方法等の特例に関する法律（電子帳簿保存法）に基づく概要"
  :categories
  {:electronic-transactions
   {:mandatory? true
    :summary "電子取引（メール・クラウド等で授受したPDFの請求書・領収書等）は電子データのまま保存することが義務。紙保存への出力代替不可。真実性・可視性の確保が必要。"}
   :electronic-books
   {:mandatory? false
    :summary "最初からPC等で作成した国税関係帳簿書類のデータ保存は任意。優良電子帳簿は過少申告加算税の軽減等の特典あり。"}
   :scanner-storage
   {:mandatory? false
    :summary "紙で受領または作成した書類をスキャナ等で読み取って保存する制度（任意）。"}}}

